# Copy this file's variable names into Vercel's Project Settings →
# Environment Variables. Never commit a real .env file with actual values.

# From Midtrans Dashboard → Settings → Access Keys (Sandbox for testing).
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# The full contents of the Firebase service account JSON file, minified to
# a single line (see README.md for how to produce this).
FIREBASE_SERVICE_ACCOUNT=
